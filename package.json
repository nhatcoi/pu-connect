{
  "name": "pu-connector-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "build:fe": "turbo run build --filter=@pu/web",
    "build:admin": "turbo run build --filter=@pu/admin",
    "build:api": "turbo run build --filter=@pu/api",
    "start": "turbo run start",
    "start:fe": "turbo run start --filter=@pu/web",
    "start:api": "turbo run start --filter=@pu/api",
    "deploy:vps": "bash scripts/deploy.sh",
    "deploy:mac": "bash scripts/deploy-mac-vps.sh",
    "docs:erd": "node scripts/gen-erd.mjs",
    "user:insight": "bash scripts/ops/user-insight.sh",
    "bot:sim": "node tools/bot-simulator/daemon.mjs",
    "bot:setup": "node tools/bot-simulator/setup-bots.mjs",
    "dev": "turbo run dev",
    "dev:fe": "turbo run dev --filter=@pu/web",
    "dev:admin": "turbo run dev --filter=@pu/admin",
    "dev:api": "turbo run dev --filter=@pu/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
