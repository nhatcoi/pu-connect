{
  "name": "pu-connector-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "build:fe": "turbo run build --filter=@pu/web",
    "build:admin": "turbo run build --filter=@pu/admin",
    "build:docs": "turbo run build --filter=@pu/docs",
    "build:api": "turbo run build --filter=@pu/api",
    "start": "turbo run start",
    "start:fe": "turbo run start --filter=@pu/web",
    "start:api": "turbo run start --filter=@pu/api",
    "deploy:vps": "bash scripts/deploy.sh",
    "deploy:mac": "bash scripts/deploy-mac-vps.sh",
    "docs:erd": "node scripts/gen-erd.mjs",
    "user:insight": "bash scripts/ops/user-insight.sh",
    "bot:setup": "node tools/bot-simulator/setup-bots.mjs",
    "dev": "turbo run dev",
    "dev:fe": "turbo run dev --filter=@pu/web",
    "dev:admin": "turbo run dev --filter=@pu/admin",
    "dev:docs": "turbo run dev --filter=@pu/docs",
    "dev:api": "turbo run dev --filter=@pu/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-model": "1.25.12",
      "prosemirror-transform": "1.12.4",
      "prosemirror-view": "1.42.9",
      "prosemirror-state": "1.4.4",
      "prosemirror-keymap": "1.2.3",
      "prosemirror-history": "1.5.1",
      "prosemirror-dropcursor": "1.8.4",
      "prosemirror-gapcursor": "1.4.1",
      "prosemirror-commands": "1.7.2",
      "prosemirror-changeset": "2.4.6"
    }
  }
}
