PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://pu_user:pu_password@localhost:5432/pu_connector_db
# Bắt buộc ở production (openssl rand -hex 32); session lưu bảng user_sessions
SESSION_SECRET=your_secret_session_key_here

# Google OAuth (tùy chọn — bỏ trống thì ẩn nút "Tiếp tục với Google")
# Callback phải khớp "Authorized redirect URI" trong Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# N7AI Google connectors (Drive / Calendar / Gmail / Forms / Sheets / Tasks) via self-hosted workspace-mcp.
# Optional dedicated OAuth client for connectors; if unset, connectors use GOOGLE_CLIENT_ID/SECRET.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
# Authorized redirect URI must exactly match this callback (or GOOGLE_CALLBACK_URL if unset).
# GOOGLE_CONNECTOR_CALLBACK_URL=http://localhost:3000/api/ai/connectors/google/callback
# workspace-mcp endpoint (taylorwilsdon/google_workspace_mcp, EXTERNAL_OAUTH21_PROVIDER, read-only). See docs/core/14.
GOOGLE_WORKSPACE_MCP_URL=http://127.0.0.1:8765/mcp
# Khóa mã hóa refresh token connector (mặc định dùng SESSION_SECRET; đổi khóa ⇒ người dùng phải kết nối lại)
CONNECTOR_ENCRYPTION_KEY=
# PU Connect: remote PKA service; university SSO stays on PKA.
PKA_CONNECTOR_URL=https://pka.vnhat.dev

# Xác thực email (SMTP). Bỏ trống SMTP_HOST thì chỉ ghi link xác thực vào log (dev)
APP_URL=http://localhost:3000
# Origin bổ sung được phép gọi API/WebSocket kèm cookie (phân tách bằng dấu phẩy)
CORS_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PU Connect <no-reply@puc.vnhat.dev>"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=pu-connector
R2_PUBLIC_URL=https://your_r2_public_domain.r2.dev

# Hàng đợi BullMQ (Redis, chỉ localhost — docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6379
# Web Push: tạo bằng `npx web-push generate-vapid-keys`; thiếu ⇒ chỉ có thông báo in-app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# N7AI (@n7ai, /messages): Gateway Provider và Model được quản lý hoàn toàn bởi Admin
# trên Admin Console (/admin/#/ai?tab=llm), lưu trữ an toàn trong DB (ai_providers, ai_models).
# Số lượt hỏi N7AI / người / ngày (giờ Việt Nam)
AI_DAILY_QUOTA=30

# N7AI: tìm kiếm web (connector "Tìm kiếm web"); bỏ trống ⇒ tắt
TAVILY_API_KEY=

# N7AI: tìm kiếm bài báo khoa học Semantic Scholar (tùy chọn; không có key vẫn hoạt động qua arXiv fallback)
SEMANTIC_SCHOLAR_API_KEY=

# RAG N7AI: server embedding OpenAI-compatible (/v1/embeddings). Trống ⇒ chỉ tìm full-text
# Prod: Ollama trên Mac mini qua reverse SSH tunnel (scripts/ops/setup-embed-tunnel.sh)
EMBED_BASE_URL=
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_API_KEY=
# OCR trang PDF scan / chữ rác cho RAG: mặc định AI gateway (AI_BASE_URL + AI_API_KEY); local: OCR_BASE_URL=http://127.0.0.1:11435/v1 OCR_MODEL=qwen2.5vl:7b
OCR_MODEL=gemini-3.7-flash-medium
OCR_BASE_URL=
OCR_API_KEY=
OCR_MAX_PAGES=30
OCR_ENABLED=true
